# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Claude API key used by the agent's judgment step (server-side only).
ANTHROPIC_API_KEY=

# Optional: TfL Unified API key (raises rate limits; the feed works without it).
TFL_APP_KEY=

# Databricks: name of the CLI profile created with `databricks auth login`.
DATABRICKS_PROFILE=walknight
# SQL warehouse id used by the app to read the published overlay (set by scripts/databricks_deploy.py).
DATABRICKS_WAREHOUSE_ID=
