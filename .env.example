# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Claude API key used by the agent's judgment step (server-side only).
ANTHROPIC_API_KEY=

# Optional: TfL Unified API key (raises rate limits; the feed works without it).
TFL_APP_KEY=

# Databricks: name of the CLI profile created with `databricks auth login`.
DATABRICKS_PROFILE=
# SQL warehouse id used by the app to read the published overlay (set by scripts/databricks_deploy.py).
DATABRICKS_WAREHOUSE_ID=

# Read the published overlay from Databricks (default "local" reads var/store, for offline development).
LANTERN_STORE=local

# --- Walking companion (live avatar call inside navigation). All server-side only. ---
# LiveKit project: room tokens, plus speech recognition and voice through LiveKit Inference.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Synthesia Studio > Developers > API keys > New API key, scope "Interactive Avatars (write)".
SYNTHESIA_API_KEY=
# Optional. Defaults are in companion/agent.py.
# SYNTHESIA_AVATAR_ID=
# COMPANION_VOICE_ID=
# COMPANION_LLM_MODEL=claude-haiku-5-5
